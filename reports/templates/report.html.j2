<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Agent Tool-Abuse Audit Report</title>
  <style>
    :root {
      --bg: #ffffff;
      --fg: #1a1a1a;
      --muted: #6b7280;
      --card-bg: #f9fafb;
      --border: #e5e7eb;
      --danger: #b91c1c;
      --success: #15803d;
      --warning: #a16207;
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #111827;
        --fg: #e5e7eb;
        --muted: #9ca3af;
        --card-bg: #1f2937;
        --border: #374151;
        --danger: #fca5a5;
        --success: #86efac;
        --warning: #fcd34d;
      }
    }
    body {
      margin: 0;
      padding: 2rem;
      background: var(--bg);
      color: var(--fg);
      font-family: system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
      line-height: 1.5;
    }
    h1, h2, h3 { margin-top: 1.5rem; }
    h3 { margin-bottom: 0.5rem; }
    table { border-collapse: collapse; margin: 1rem 0; width: 100%; max-width: 600px; }
    th, td { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
    th { background: var(--card-bg); }
    .finding { border: 1px solid var(--border); border-radius: 8px; padding: 1rem; margin: 1rem 0; background: var(--card-bg); }
    .status { font-weight: 600; }
    .status-Vulnerable { color: var(--danger); }
    .status-Mitigated { color: var(--success); }
    .status-Error { color: var(--warning); }
    pre {
      background: var(--card-bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 1rem;
      overflow-x: auto;
      white-space: pre-wrap;
    }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
  </style>
</head>
<body>
  <h1>Agent Tool-Abuse Audit Report</h1>

  <h2>Executive Summary</h2>
  <p><strong>Total findings:</strong> {{ summary.total }}</p>

  <table>
    <tr><th>Status</th><th>Count</th></tr>
    <tr><td class="status status-Vulnerable">Vulnerable</td><td>{{ summary.status_counts.get('Vulnerable', 0) }}</td></tr>
    <tr><td class="status status-Mitigated">Mitigated</td><td>{{ summary.status_counts.get('Mitigated', 0) }}</td></tr>
    <tr><td class="status status-Error">Error</td><td>{{ summary.status_counts.get('Error', 0) }}</td></tr>
  </table>

  <table>
    <tr><th>Attack Class</th><th>Count</th></tr>
    {% for attack, count in summary.attack_counts.items() %}
    <tr><td>{{ attack }}</td><td>{{ count }}</td></tr>
    {% endfor %}
  </table>

  <h2>Findings</h2>
  {% for record in records %}
  <div class="finding">
    <h3>{{ record.case_id }} - {{ record.test_name }}</h3>
    <p>
      <strong>Attack Class:</strong> {{ record.attack_class }}<br>
      <strong>OWASP:</strong> {{ record.owasp }}<br>
      <strong>Status:</strong> <span class="status status-{{ record.status }}">{{ record.status }}</span><br>
      <strong>Description:</strong> {{ record.description }}
    </p>

    <h4>Raw Trace</h4>
    <pre><code>{{ record.raw_trace | tojson(indent=2) }}</code></pre>

    <h4>Remediation Ticket</h4>
    <p><strong>Title:</strong> Remediate {{ record.attack_class }} in {{ record.test_name }}</p>
    <p><strong>Priority:</strong> High</p>
    <p><strong>Description:</strong> {{ record.description }}</p>
    <p><strong>Remediation:</strong> {{ record.remediation }}</p>
    <p><strong>Acceptance Criteria:</strong></p>
    <ul>
      <li>Tool policy prevents the vulnerable tool call or argument pattern from occurring.</li>
      <li>The fixed-scope guardrails are enforced before any outbound request.</li>
      <li>Regression test {{ record.case_id }} passes (Mitigated) in the audit suite.</li>
    </ul>
  </div>
  {% endfor %}
</body>
</html>
